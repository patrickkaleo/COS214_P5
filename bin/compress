#!/bin/bash
zipname="COS214_P5.zip"
# zip the necessary h and cpp files
find . -regextype posix-extended -regex "\./(bin|build|obj[^/]*)" -prune -o -regex ".*/[A-Za-z0-9]+\.(cpp|h)" -exec zip -j "$zipname" {} +
rm submission.pdf
./bin/pdf #create the pdf submission file
zip -j "$zipname" Makefile submission.pdf Dockerfile docker-compose.yml

echo "Created $zipname"
unzip -l "$zipname" #list zipped files 